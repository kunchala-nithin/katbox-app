{
  "expo": {
    "name": "KatBox",
    "slug": "katbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "katbox",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#073B1E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.katbox",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow access to your photos to upload restaurant image",
        "NSCameraUsageDescription": "Allow access to camera to upload restaurant image",
        "NSPhotoLibraryAddUsageDescription": "Allow KatBox to save the payment QR scanner to your gallery.",
        "NSLocationWhenInUseUsageDescription": "KatBox uses your location to find nearby chefs and estimate delivery times.",
        "LSApplicationQueriesSchemes": [
          "phonepe",
          "tez",
          "gpay",
          "paytm",
          "paytmmp",
          "bhim",
          "upi",
          "amazonpay",
          "credpay",
          "cashfree",
          "tel",
          "telprompt",
          "mailto"
        ],
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#166348"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.katbox",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ],
      "notification": {
        "icon": "./assets/images/notification-icon.png",
        "color": "#073B1E",
        "channelId": "orders-alarm-admin",
        "sounds": [
          "./assets/sounds/alarm.mp3"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow KatBox to access your photos.",
          "savePhotosPermission": "Allow KatBox to save the payment QR scanner to your gallery.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#073B1E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/alarm.mp3"
          ],
          "mode": "production",
          "icon": "./assets/images/notification-icon.png",
          "color": "#073B1E",
          "defaultChannel": "orders-alarm-admin"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "KatBox uses your location to find nearby chefs and estimate delivery times.",
          "locationWhenInUsePermission": "KatBox uses your location to find nearby chefs and estimate delivery times.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "755f263f-5aad-4374-ae7a-0dda8480e0ff"
      }
    },
    "owner": "katbox-app"
  }
}